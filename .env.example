NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Public reCAPTCHA Enterprise site key used by Firebase App Check.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Optional Google Identity Services client ID. Firebase Google sign-in works without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Set to true only after GitHub is enabled in Firebase Authentication.
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false
# Server-only Vercel Blob credential. Never prefix this variable with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
